# Copia este archivo a .env y cambia los valores. El archivo .env nunca se sube al repositorio.

POSTGRES_DB=adminpro
POSTGRES_USER=adminpro
POSTGRES_PASSWORD=cambia_esta_clave

# dev y demo cargan datos de prueba. prod no los carga y apaga Swagger.
SPRING_PROFILES_ACTIVE=dev

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=reemplaza_este_valor_por_uno_aleatorio_de_32_o_mas_caracteres

# false solo para desarrollo por HTTP. Con HTTPS debe ser true.
COOKIE_SECURE=false

# Crea el primer Administrador si no existe ninguno. Usar en prod; dev y demo ya traen usuarios.
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_PASSWORD=

# Puertos en tu equipo. 55432 evita chocar con instalaciones locales de PostgreSQL.
DB_PORT=55432
API_PORT=8080
